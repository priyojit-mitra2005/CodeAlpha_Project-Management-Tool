{
  "name": "project-management-tool",
  "version": "1.0.0",
  "description": "Collaborative project management tool with Kanban boards, tasks, real-time WebSockets, and authentication",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "vite --config client/vite.config.js client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build --config client/vite.config.js client"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
